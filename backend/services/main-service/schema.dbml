
Project main_db {
  database_type: 'PostgreSQL'
  Note: 'Main service db'
}

Enum user_role {
  client, // can only get notifications
  user, // can make user articles, have and profile (in future)
  admin, // user + can make crud of all users (except admins), articles, projects, etc.
  root, // admin + can make crud of all users
}

Enum user_status { 
  pending_verification
  verificated
  blocked
}

Table users {
  id bigint [pk, increment]
  username varchar [note: 'Slug-based string ID like niyazgim']
  name varchar
  surname varchar
  email varchar [unique]
  phone varchar [unique]
  password varchar [not null]
  description text [note: 'Short bio/description']
  avatar_url varchar
  user_role user_role [default: 'user']
  user_status user_status [default: 'pending_verification']
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}

Table articles {
  id uuid [pk]
  slug varchar [unique, not null]
  title varchar [not null]
  description text
  content_json jsonb [note: 'Novel/Tiptap JSON document']
  lang varchar [not null, default: 'ru', note: 'Content language: ru | en']
  translation_group_id uuid [not null, note: 'Shared by language versions of one post']
  cover_image_src varchar
  cover_video_src varchar
  category varchar
  tags jsonb [not null, default: `'[]'::jsonb`]
  author_name varchar
  author_avatar_url varchar
  is_team_author boolean [not null, default: true]
  seo_title varchar
  meta_description varchar
  is_featured boolean [not null, default: false]
  status varchar [not null, default: 'draft']
  sort_order int [default: 0]
  published_at timestamp
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
  deleted_at timestamp
}

Table solutions {
  id uuid [pk]
  slug varchar [unique, not null]
  title varchar [not null]
  short_description varchar
  description text
  mdx_content text [note: 'Legacy MDX body']
  content_json jsonb [note: 'Novel/Tiptap JSON document']
  cover_image_src varchar
  cover_video_src varchar
  href varchar
  platform varchar
  category varchar
  period varchar
  tech_stack jsonb [not null, default: `'[]'::jsonb`]
  tags jsonb [not null, default: `'[]'::jsonb`]
  client_id uuid
  client_name varchar
  custom_page varchar
  page varchar
  seo_title varchar
  meta_description varchar
  is_featured boolean [not null, default: false]
  status varchar [not null, default: 'draft']
  sort_order int [default: 0]
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
  deleted_at timestamp
}