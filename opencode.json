{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    {
      "action": "read",
      "resource": "secrets/*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*.key",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*.pem",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "secrets/*",
      "effect": "deny"
    }
  ],
  "mcp": {
    "codebase-memory": {
      "type": "local",
      "command": [
        "/home/agent/.local/bin/codebase-memory-mcp"
      ],
      "enabled": true
    }
  }
}