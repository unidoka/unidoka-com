{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    {
      "action": "read",
      "resource": "secrets/*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*.key",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*.pem",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "secrets/*",
      "effect": "deny"
    }
  ],
  "mcp": {
    "repomapper": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-repomapper"
      ],
      "enabled": true
    }
  }
}